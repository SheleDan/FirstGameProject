  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f1662cc838161894a99c37fee2421d17, type: 3}
  m_Name: VillageElderAfterBattle
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue.DialogueData
  lines:
  - speakerName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435, \u043F\u0443\u0442\u043D\u0438\u043A.
      \u0415\u0441\u043B\u0438 \u0431\u044B \u043D\u0435 \u0442\u044B, \u043D\u0430\u0448\u0430
      \u0434\u0435\u0440\u0435\u0432\u043D\u044F \u0431\u044B\u043B\u0430 \u0431\u044B
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0430."
    portrait: {fileID: 21300000, guid: ca36bb051a6b02241b04b1cb10031c7d, type: 3}
  - speakerName: "\u0413\u0435\u0440\u043E\u0439"
    text: "\u0427\u0442\u043E \u044D\u0442\u043E \u0431\u044B\u043B\u0438 \u0437\u0430
      \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0430? \u0420\u0430\u043D\u044C\u0448\u0435
      \u044F \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432."
    portrait: {fileID: 21300000, guid: 4e7a5f0c135e2d84a9da53dabd55bc7c, type: 3}
  - speakerName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    text: "\u0418\u0437 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0437\u0435\u043C\u0435\u043B\u044C
      \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u044B\u0435
      \u0432\u0435\u0441\u0442\u0438. \u041F\u043E \u0432\u0441\u0435\u043C\u0443
      \u043C\u0438\u0440\u0443 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0440\u0430\u0437\u0440\u044B\u0432\u044B \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0432\u0430."
    portrait: {fileID: 21300000, guid: ca36bb051a6b02241b04b1cb10031c7d, type: 3}
  - speakerName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    text: "\u0427\u0435\u0440\u0435\u0445 \u043D\u0438\u0445 \u0434\u0443\u0445\u0438
      \u0438 \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0430 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0442
      \u0432 \u043D\u0430\u0448 \u043C\u0438\u0440. \u0415\u0441\u043B\u0438 \u0440\u0430\u0437\u0440\u044B\u0432\u044B
      \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u044C, \u0445\u0430\u043E\u0441
      \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u0442 \u0432\u0441\u0451 \u0432\u043E\u043A\u0440\u0443\u0433."
    portrait: {fileID: 21300000, guid: ca36bb051a6b02241b04b1cb10031c7d, type: 3}
  - speakerName: "\u0413\u0435\u0440\u043E\u0439"
    text: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0435
      \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u0431\u044B\u043B\u043E
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0447\u0430\u043B\u043E\u043C?"
    portrait: {fileID: 21300000, guid: 4e7a5f0c135e2d84a9da53dabd55bc7c, type: 3}
  - speakerName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    text: "\u0411\u043E\u044E\u0441\u044C, \u0447\u0442\u043E \u0434\u0430... \u0422\u044B
      \u0441\u0443\u043C\u0435\u043B \u043E\u0434\u043E\u043B\u0435\u0442\u044C \u044D\u0442\u0438\u0445
      \u0442\u0432\u0430\u0440\u0435\u0439, \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0435\u0431\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
      \u043D\u0430\u0439\u0442\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0440\u0430\u0437\u0440\u044B\u0432\u043E\u0432"
    portrait: {fileID: 21300000, guid: ca36bb051a6b02241b04b1cb10031c7d, type: 3}
